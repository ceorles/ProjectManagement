# Copy this file to `.env` and adjust the values.
# `.env` is ignored by git and must never be committed.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# True for local development only.
DJANGO_DEBUG=True

# Comma-separated hostnames the backend may be served from.
# Add your computer's LAN IP here to test from a phone on the same Wi-Fi.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Time zone the library operates in (IANA name).
LIBRARY_TIME_ZONE=Asia/Manila

# Frontend origins allowed to call the API directly (comma-separated).
# Not needed when the frontend reaches the API through the Vite proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Refresh-token cookie. Use Secure=True whenever the site is served over HTTPS.
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax

# Token lifetimes.
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7

# Database. SQLite is used when DB_ENGINE is not set.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=library_portal
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
