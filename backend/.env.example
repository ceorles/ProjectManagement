# Copy this file to `.env` and adjust the values.
# `.env` is ignored by git and must never be committed.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# True for local development only.
DJANGO_DEBUG=True

# Comma-separated hostnames the backend may be served from.
# Add your computer's LAN IP here to test from a phone on the same Wi-Fi.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Time zone the library operates in (IANA name).
LIBRARY_TIME_ZONE=Asia/Manila

# Frontend origins allowed to call the API directly (comma-separated).
# Not needed when the frontend reaches the API through the Vite proxy.
# In production use the https:// address of the frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Sites allowed to submit forms to Django. Defaults to CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com

# Refresh-token cookie. Use Secure=True whenever the site is served over HTTPS.
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax

# Token lifetimes.
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7

# Production database: the full connection string from Render PostgreSQL or
# Supabase. When it is set, the DB_* values below are ignored.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Database. SQLite is used when neither DATABASE_URL nor DB_ENGINE is set.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=library_portal
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Where uploaded photos are kept. On Render this must be on the persistent disk.
# MEDIA_DIR=/var/data/media

# Background scheduler: cancels confirmed reservations 15 minutes after their
# start time when nobody has checked in. It runs inside the web server.
# Set to False only if `python manage.py run_reservation_scheduler` runs separately.
RESERVATION_SCHEDULER_ENABLED=True
RESERVATION_SCHEDULER_INTERVAL_SECONDS=30
