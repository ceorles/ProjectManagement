# Copy this file to `.env` (or `.env.local`) and adjust the values.
# Only variables that start with VITE_ are exposed to the browser.

# Where the frontend sends API requests.
#
#   /api  (default)  Same origin. In development Vite forwards these requests
#                    to VITE_BACKEND_ORIGIN, so no CORS setup is needed and
#                    the app also works from a phone on the same Wi-Fi.
#
#   A full URL       e.g. https://library-api.example.edu/api
#                    Use this when the API is hosted on a different origin.
#                    That origin must list this site in CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api

# Django server that /api is forwarded to by `npm run dev` and `npm run preview`.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Name shown in the app and used for the installed PWA.
VITE_APP_NAME=LibReserve

# Name of the institution shown under the app name.
VITE_INSTITUTION_NAME=University Library
